{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osap:schema:consent-request:0.1",
  "title": "OSAP Consent Request Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "task_id",
    "agent",
    "audience",
    "actions",
    "resources",
    "risk",
    "summary",
    "options"
  ],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "agent": { "type": "string", "pattern": "^agent://" },
    "audience": { "type": "string", "pattern": "^agent://" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "risk": { "type": "string", "enum": ["L0", "L1", "L2", "L3", "L4"] },
    "summary": { "type": "string", "minLength": 1 },
    "intent_preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actor": { "type": "string" },
        "what": { "type": "string" },
        "data": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "money": { "type": "number", "minimum": 0 },
            "external_calls": { "type": "integer", "minimum": 0 }
          }
        },
        "ttl": { "type": "string" },
        "irreversible": { "type": "boolean" }
      }
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["allow_once", "allow_task", "allow_ttl", "deny"]
      }
    }
  }
}
