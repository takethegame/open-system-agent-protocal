{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osap:schema:discover:0.1",
  "title": "OSAP Discovery Request Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "requires"],
  "properties": {
    "intent": { "type": "string", "minLength": 1 },
    "requires": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "schemas": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "risk_max": { "type": "string", "enum": ["L0", "L1", "L2", "L3", "L4"] },
    "sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["native", "vendor_registry", "mcp", "a2a", "dbus", "openapi", "bridge"]
      }
    },
    "limit": { "type": "integer", "minimum": 1 }
  }
}
