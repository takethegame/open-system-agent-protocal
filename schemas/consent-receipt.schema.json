{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osap:schema:consent-receipt:0.1",
  "title": "OSAP Consent Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "osap_receipt",
    "receipt_id",
    "user",
    "agent",
    "task_id",
    "cap_id",
    "audience",
    "actions",
    "resources",
    "risk",
    "decision",
    "issued_at",
    "proof"
  ],
  "properties": {
    "osap_receipt": { "type": "string", "pattern": "^0\\.[0-9]+$" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "user": { "type": "string", "pattern": "^user://" },
    "agent": { "type": "string", "pattern": "^agent://" },
    "task_id": { "type": "string", "minLength": 1 },
    "cap_id": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "pattern": "^agent://" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "risk": { "type": "string", "enum": ["L0", "L1", "L2", "L3", "L4"] },
    "decision": { "type": "string", "enum": ["grant", "deny"] },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_uses": { "type": "integer", "minimum": 1 },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "policy_hash": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "kid", "sig"],
      "properties": {
        "alg": { "type": "string", "enum": ["EdDSA"] },
        "kid": { "type": "string", "minLength": 1 },
        "sig": { "type": "string", "minLength": 1 }
      }
    },
    "extensions": { "type": "object" }
  }
}
