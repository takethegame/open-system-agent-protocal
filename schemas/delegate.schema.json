{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osap:schema:delegate:0.1",
  "title": "OSAP Delegate Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "budget", "result_schema", "delegated_capability"],
  "properties": {
    "goal": { "type": "string", "minLength": 1 },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_ms"],
      "properties": {
        "wall_ms": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "tokens": { "type": "integer", "minimum": 0 },
        "money": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
            "amount": { "type": "number", "minimum": 0 }
          }
        },
        "depth": { "type": "integer", "minimum": 0 }
      }
    },
    "result_schema": { "type": "string", "minLength": 1 },
    "delegated_capability": { "$ref": "urn:osap:schema:capability:0.1" }
  }
}
