{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osap:schema:capability-record:0.1",
  "title": "OSAP Capability Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "source", "app", "agent", "capability", "policy", "provenance", "freshness"],
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "registry", "native_id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["vendor_registry", "mcp", "a2a", "dbus", "openapi", "native", "bridge"]
        },
        "registry": { "type": "string", "minLength": 1 },
        "native_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string" }
      }
    },
    "app": { "type": "string", "pattern": "^app://" },
    "agent": { "type": "string", "pattern": "^agent://" },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cap", "actions", "resources", "schemas", "risk"],
      "properties": {
        "cap": { "type": "string", "pattern": "^cap://" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "risk": { "type": "string", "enum": ["L0", "L1", "L2", "L3", "L4"] },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "latency_ms_p50": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "consent"],
      "properties": {
        "visibility": { "type": "string", "enum": ["discoverable", "restricted", "hidden"] },
        "consent": { "type": "string", "enum": ["none", "first_use", "per_task", "per_use"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust", "attested_at"],
      "properties": {
        "trust": { "type": "string", "enum": ["system", "verified", "unverified"] },
        "signature": { "type": "string" },
        "attested_at": { "type": "string", "format": "date-time" }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "expires_at"],
      "properties": {
        "observed_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "extensions": { "type": "object" }
  }
}
